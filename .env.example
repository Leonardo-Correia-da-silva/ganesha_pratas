# ─── Firebase (client — safe to expose in the browser) ─────────────────────
# Get these from Firebase Console > Project settings > General > Your apps > Web app.
# These are public configuration values, not secrets — Firestore/Storage security rules
# (see firestore.rules and storage.rules) are what actually protect your data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fallback WhatsApp number used before store settings are configured in the admin panel.
# Format: country code + area code + number, digits only (e.g. 5519999999999).
VITE_OWNER_WHATSAPP=

# ─── Server-side only (NEVER prefix with VITE_ — these must stay off the client) ──

# Admin login credentials (there is only ONE administrator: the store owner).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Firebase Admin SDK service account (Firebase Console > Project settings > Service accounts
# > Generate new private key). Used only in api/** serverless functions, never sent to the browser.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
